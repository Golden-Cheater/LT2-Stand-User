local genv = getgenv()
local plrs = game:GetService("Players")
local lplr = plrs.LocalPlayer
local https = game:GetService("HttpService")
local runs = game:GetService("RunService")
local startergui = game:GetService("StarterGui")

local owner = tostring(genv.Owner)
local stand = tostring(genv.Stand)
local userid = tostring(lplr.UserId)
local role = (userid == owner and "owner") or (userid == stand and "stand")

if not role then
  return warn("[Star Platinum]: You Are Not The Owner Or The Stand!")
end

local ok_ws, ws = pcall(WebSocket.connect, "wss://jojo-bridge.bot-keep.xyz/ws")
if not ok_ws then
  return warn("[Star Platinum]: Failed to connect: "..tostring(ws))
end

local active,paired,summoned = true,false,false
local char,hum,hrp,stand_char
local follow,owner_conn,owner_hrp
local conns = {}
local api

local scale = Vector3.new(.84,.85,.8)
local limbs = {"Head","Torso","Right Arm","Left Arm","Right Leg","Left Leg"}

local function now()
  return workspace:GetServerTimeNow()
end

local function notify(...)
  local args = {...}
  local data = {
    Title = "Star Platinum",
    Text = args[1] or "",
    Duration = args[2] or 4
  }
  if args[3] ~= true then
    data.Icon = "rbxassetid://7733658504"
  end
  pcall(function()
    startergui:SetCore("SendNotification",data)
  end)
end

local function send(data)
  if active then
    pcall(function() ws:Send(https:JSONEncode(data)) end)
  end
end

local function stylize(plr,new)
  if new:GetAttribute("StarPlatinum") then
    return
  end
  new:SetAttribute("StarPlatinum",true)

  local waited = 0
  while not plr:HasAppearanceLoaded() and waited < 5 do
    waited += task.wait()
  end

  local root = new:WaitForChild("HumanoidRootPart")
  local torso = new:WaitForChild("Torso")
  local parts,rainbow = {},{}

  for k,v in ipairs(limbs) do
    local obj = new:WaitForChild(v)
    obj.Material = Enum.Material.ForceField
    rainbow[k] = obj
    if v ~= "Head" then
      parts[obj] = true
      obj.Size *= scale
      obj.Shape = Enum.PartType.Block
    end
  end

  for _,obj in ipairs(new:GetDescendants()) do
    if obj:IsA("CharacterMesh") and obj.BodyPart ~= Enum.BodyPart.Head or parts[obj.Parent] and obj:IsA("DataModelMesh") then
      obj:Destroy()
    elseif obj:IsA("Motor6D") then
      if parts[obj.Part0] then
        obj.C0 = CFrame.new(obj.C0.Position*scale)*obj.C0.Rotation
      end
      if parts[obj.Part1] then
        obj.C1 = CFrame.new(obj.C1.Position*scale)*obj.C1.Rotation
      end
    elseif obj:IsA("Attachment") and parts[obj.Parent] then
      obj.Position *= scale
    end
  end

  local motors = {
    root:WaitForChild("RootJoint"),
    torso:WaitForChild("Neck"),
    torso:WaitForChild("Right Shoulder"),
    torso:WaitForChild("Left Shoulder"),
    torso:WaitForChild("Right Hip"),
    torso:WaitForChild("Left Hip"),
  }

  local bases = {}
  for k,v in ipairs(motors) do
    bases[k] = v.C0
  end

  local function pose(key,pos,x,z)
    return CFrame.new(bases[key].Position+pos)*CFrame.Angles(math.rad(x),0,math.rad(z))*bases[key].Rotation
  end

  local conn
  conn = runs.PreSimulation:Connect(function(dt)
    if not new.Parent then
      return conn:Disconnect()
    end

    local t = now()
    local color = Color3.fromHSV((t*.05)%1,1,1)
    for _,v in ipairs(rainbow) do
      v.Color = color
    end

    local targets = bases

    if new:GetAttribute("Summoned") then
      for _,v in ipairs(motors) do
        v.Transform = CFrame.identity
      end
      local sway = math.sin(t*2)
      local arm = 4+sway*2
      targets = {
        pose(1,Vector3.new(0,1.5,0),0,0),
        bases[2],
        pose(3,Vector3.zero,sway*3,arm),
        pose(4,Vector3.zero,-sway*3,-arm),
        pose(5,Vector3.new(0,.4,-.64)*scale,-13+sway*2,0),
        pose(6,Vector3.new(0,.2,-.22)*scale,-2-sway,0),
      }
    end

    local alpha = 1-math.exp(-12*dt)
    for k,v in ipairs(motors) do
      v.C0 = v.C0:Lerp(targets[k],alpha)
    end
  end)
end

local function setsummoned(state)
  summoned = state
  if stand_char then
    stand_char:SetAttribute("Summoned",state)
  end
  if role == "stand" then
    send({type = "result",data = {summoned = state}})
  end
end

local function track(plr)
  local function onchar(new)
    stand_char = new
    new:SetAttribute("Summoned",summoned)
    stylize(plr,new)
  end
  if plr.Character then
    task.spawn(onchar,plr.Character)
  end
  table.insert(conns,plr.CharacterAdded:Connect(onchar))
end

local function setchar(new)
  char,hum,hrp = new,nil,nil
  hum = new:WaitForChild("Humanoid")
  hrp = new:WaitForChild("HumanoidRootPart")
end

if lplr.Character then
  task.spawn(setchar,lplr.Character)
end

table.insert(conns,lplr.CharacterAdded:Connect(setchar))

if role == "stand" then
  track(lplr)
else
  local stand_plr = plrs:GetPlayerByUserId(tonumber(stand))
  if stand_plr then
    track(stand_plr)
  end
  table.insert(conns,plrs.PlayerAdded:Connect(function(plr)
    if tostring(plr.UserId) == stand then
      track(plr)
    end
  end))
end

local function unsummon()
  if follow then
    follow:Disconnect()
    owner_conn:Disconnect()
    follow,owner_conn,owner_hrp = nil,nil,nil
  end
  setsummoned(false)
end

local function summon()
  if follow then
    return unsummon()
  end
  local owner_plr = plrs:GetPlayerByUserId(tonumber(owner))
  if not owner_plr then
    return
  end
  owner_hrp = (owner_plr.Character or owner_plr.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
  owner_conn = owner_plr.CharacterAdded:Connect(function(new)
    owner_hrp = nil
    owner_hrp = new:WaitForChild("HumanoidRootPart")
  end)
  follow = runs.Heartbeat:Connect(function()
    if hrp and owner_hrp then
      hrp.AssemblyLinearVelocity = Vector3.zero
      hrp.CFrame = owner_hrp.CFrame*CFrame.new(3.8,2+math.sin(now()*2)*2,1.3)
    end
  end)
  setsummoned(true)
end

local list = {
  {"stand",summon},
  {"summon",summon},
  {"star platinum",summon},
  {"unsummon",unsummon},
  {"stop",unsummon},
}

local commands,names = {},{}

for _,entry in list do
  commands[entry[1]] = entry[2]
  table.insert(names,entry[1])
end

local function CleanUp()
  if not active then
    return
  end
  active,paired = false,false
  unsummon()
  for _,conn in ipairs(conns) do
    conn:Disconnect()
  end
  pcall(ws.Close,ws)
  if genv.StandAPI == api then
    genv.StandAPI = nil
  end
end

ws.OnMessage:Connect(function(raw)
  local ok_dec, msg = pcall(https.JSONDecode, https, raw)
  if not ok_dec or type(msg) ~= "table" then return end

  if msg.type == "created" then
    notify("Code: "..tostring(msg.code).." — share with your stand", 15)
    print("[Star Platinum]: Your code is "..tostring(msg.code))

  elseif msg.type == "paired" then
    paired = true
    print("[Star Platinum]: Paired As "..role)
    if role == "owner" then
      notify("Commands: "..table.concat(names,", "),10)
    else
      notify("Successfully Paired With An Owner.")
    end

  elseif msg.type == "rejected" then
    warn("[Star Platinum]: "..tostring(msg.reason))
    CleanUp()

  elseif msg.type == "cmd" and role == "stand" then
    local cmd_name = string.lower(tostring(msg.argument[1]))
    local command = commands[cmd_name]
    if command then
      task.spawn(command, table.unpack(msg.argument, 2))
    else
      warn("[Star Platinum]: Unknown command: "..tostring(msg.argument[1]))
    end

  elseif msg.type == "result" and role == "owner" and type(msg.data) == "table" then
    setsummoned(msg.data.summoned == true)
  end
end)

ws.OnClose:Connect(function()
  if active then
    print("[Star Platinum]: Disconnected")
    CleanUp()
  end
end)

local secret = tostring(genv.Secret or "")
if role == "owner" then
  send({type = "create", owner = owner, stand = stand, userid = userid, secret = secret})
else
  local code = string.upper(tostring(genv.Code or ""))
  if code == "" then
    return warn("[Star Platinum]: Owner must give you a code. Set getgenv().Code = \"XXXXXX\" before executing.")
  end
  send({type = "join", code = code, userid = userid, secret = secret})
end

task.spawn(function()
  while active do
    task.wait(20)
    send({type = "ping"})
  end
end)

api = {
  send = function(...)
    if role ~= "owner" then return warn("[Star Platinum]: Only the owner can send commands") end
    if not paired then return warn("[Star Platinum]: Not paired yet") end
    send({type = "cmd",argument = {...}})
  end,
}

genv.StandAPI = api